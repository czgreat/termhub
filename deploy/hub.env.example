# Hub settings (docs/M8 第 5 节). Keep this file readable by you only.

# Every address browsers will use, comma separated, https only. Used for the
# Origin check and cookies: an address not listed here cannot log in.
TH_PUBLIC_URL=https://192.168.1.10:27443

# Optional: plain-HTTP listener for an HTTPS reverse proxy or tunnel in front
# of the Hub. TH_TRUSTED_PROXIES must list the proxy's address (as the Hub
# sees it); forwarding headers from anyone else are ignored and their
# connections refused. Add the public https address to TH_PUBLIC_URL too.
# TH_PROXY_LISTEN=:27180
# TH_TRUSTED_PROXIES=192.168.1.1
# A shared secret the proxy sends as the X-TH-Proxy-Key header; needed when
# the proxy's address alone does not prove it is the proxy (e.g. a tunnel).
# TH_PROXY_KEY=

# Optional (defaults shown): days until an idle login expires, maximum login
# age, how long a device stays trusted after a TOTP, audit log retention.
# TH_SESSION_IDLE_DAYS=7
# TH_SESSION_MAX_DAYS=30
# TH_TRUST_DEVICE_DAYS=30
# TH_AUDIT_KEEP_DAYS=180
